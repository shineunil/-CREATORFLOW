# ==============================================================================
# [CREATORFLOW FRONTEND 환경 변수 설정]
# 프론트엔드 환경 변수는 모두 NEXT_PUBLIC_ 이 붙어있어 브라우저(클라이언트)에 노출됩니다.
# 라이브 배포(Vercel 등) 시 대시보드의 Environment Variables 세팅에 아래 값들을 추가/변경해야 합니다.
# ==============================================================================

# ---------------------------------------------------------
# 1. 백엔드 연결 주소
# ---------------------------------------------------------
# (라이브 배포 시 변경)
# 로컬: http://localhost:8000
# 라이브: https://api.creatorflow.com (실제 배포된 백엔드 서버 주소)
NEXT_PUBLIC_API_URL=https://creatorflow-sff9.vercel.app/

# ---------------------------------------------------------
# 2. Paddle 결제 클라이언트 설정
# ---------------------------------------------------------
# (라이브 배포 시 변경)
# 로컬: sandbox (테스트 모드)
# 라이브: production (실제 라이브 결제 모드)
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# (라이브 배포 시 변경)
# 로컬: 샌드박스용 Client Token
# 라이브: 패들 라이브 대시보드에서 발급받은 '라이브 Client Token'
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_9238033b9dedeeb22b63d067626

# (라이브 배포 시 변경)
# 로컬: 샌드박스에 만들어둔 구독 상품(Price) ID
# 라이브: 패들 라이브 환경에 새로 상품(Catalog)을 등록한 후, 발급된 실제 결제 Price ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO=pri_01m1psq971t3sy5h2xq0venhsg
