# ==============================================================================
# [CREATORFLOW BACKEND 환경 변수 설정]
# 이 파일은 로컬(내 컴퓨터) 환경에 맞춰진 설정입니다.
# 라이브 배포(Render 등) 시에는 서버 대시보드(Environment Variables)에 
# 아래 변수들을 복사하여 '라이브용 값'으로 변경해 주셔야 합니다.
# ==============================================================================

# ---------------------------------------------------------
# 1. 도메인 (URL) 설정
# ---------------------------------------------------------
# (라이브 배포 시 변경) 
# 로컬: http://localhost:8000
# 라이브: https://api.creatorflow.com (백엔드 배포 주소)
BACKEND_URL=http://localhost:8000

# (라이브 배포 시 변경) 
# 로컬: http://localhost:3000
# 라이브: https://creatorflow.com (프론트엔드 배포 주소)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------
# 2. 데이터베이스 설정 (현재 생략되어 SQLite 사용 중)
# ---------------------------------------------------------
# (라이브 배포 시 필수 추가) 
# 로컬: 주석 처리 또는 sqlite:///./creatorflow.db
# 라이브: postgresql://user:password@live-db.neon.tech/dbname
# DATABASE_URL=postgresql://user:password@live-db.neon.tech/dbname

# ---------------------------------------------------------
# 3. 구글 연동 (OAuth & YouTube API)
# ---------------------------------------------------------
# 키 자체는 변경하지 않아도 됩니다. 
# 단!! 구글 콘솔(Google Cloud) 설정에 들어가서 
# "승인된 리디렉션 URI"에 라이브 백엔드 주소(https://api.../api/auth/callback)를 반드시 추가해야 합니다.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---------------------------------------------------------
# 4. Paddle 결제 시스템 설정
# ---------------------------------------------------------
# (라이브 배포 시 변경)
# 로컬: sandbox (테스트 모드 키)
# 라이브: production (실제 결제용 라이브 키 발급받아 교체)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your-paddle-api-key

# (라이브 배포 시 변경)
# 로컬: 테스트용 웹훅 시크릿
# 라이브: 패들 대시보드에서 '라이브용 웹훅'을 생성(URL: https://api.creatorflow.com/api/webhooks/paddle) 후 발급된 라이브 시크릿 키 입력
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# ---------------------------------------------------------
# 5. 보안 (JWT 인증 키)
# ---------------------------------------------------------
# 유저 로그인 토큰을 암호화하는 비밀번호입니다.
# (라이브 배포 시 변경 권장) 라이브 서버에서는 임의의 아주 길고 복잡한 새 문자열을 생성해서 넣는 것이 안전합니다.
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------
# 6. 썸네일 클라우드 스토리지 (Cloudinary)
# ---------------------------------------------------------
# (라이브 배포 시 필수) 설정하지 않으면 썸네일이 Render 로컬 디스크에만 저장되어
# 재배포 시 파일이 유실됩니다. cloudinary.com 무료 계정에서 발급받아 채워주세요.
# 로컬 개발 시에는 비워두면 자동으로 로컬 uploads/ 폴더에 저장됩니다.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------
# 7. 관리자 대시보드 (/admin 페이지 접근 허용 이메일, 쉼표로 여러 개 구분 가능)
# ---------------------------------------------------------
# 비워두면 /admin과 /api/admin/* 는 누구도 접근할 수 없습니다 (기본값: 전부 차단).
ADMIN_EMAILS=

# ---------------------------------------------------------
# 8. 에러 모니터링 (Sentry) - 선택, 비워두면 비활성화
# ---------------------------------------------------------
# sentry.io에서 무료 계정을 만들고 Python(FastAPI) 프로젝트를 생성하면 DSN을 발급받을 수 있습니다.
# 설정해두면 배포 환경에서 발생하는 에러(이 코드베이스 곳곳의 logger.error() 호출 포함)가
# 자동으로 Sentry 대시보드에 쌓이고, 원하면 이메일/슬랙 알림도 받을 수 있습니다.
# 로그 파일을 직접 뒤지지 않아도 되는 게 핵심 이점입니다.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1     # 성능 추적 샘플링 비율(0~1). 트래픽 많아지면 낮추세요.

# ---------------------------------------------------------
# 9. 테스트 정책 (선택 - 비워두면 backend/test_policy.py의 기본값 사용)
# ---------------------------------------------------------
# MIN_TEST_CYCLES=2                # 승자 확정 전 최소 A/B/C 순환 사이클 수
# MIN_WINNER_SAMPLE_VIEWS=50        # 승자 확정에 필요한 최소 누적 조회수 증가량
# MAX_AUTO_TEST_EXTENSIONS=2        # 사이클/표본 부족 시 자동 연장 최대 횟수
# SWAP_WARMUP_MINUTES=15            # 스왑 직후 잔상 노출을 배제할 워밍업 구간(분)
# BASIC_MIN_SWAP_INTERVAL_MINUTES=240  # BASIC 요금제 최소 교체 주기(분). 이보다 짧으면 PRO 전용
